# ─── Build output ────────────────────────────────────────────────────────
# Rust build output
/target/

# Host property-test crate build output (separate, host-target workspace)
/host-tests/target/

# ISO / boot staging directory (regenerated by run.cmd on every run)
/iso_root/

# Linked kernel ELF (produced by run.cmd / build.sh from libpagh.a)
/PAGH.elf
/pagh.elf

# ─── Developer-provided / downloaded blobs (needed by run.cmd) ─────────────
# Bootable disk image
/boot.img

# virtio-blk disk image (generated by run.cmd)
/disk.img

# Firmware (download locally)
/OVMF.fd

# Limine bootloader trees (any version; auto-downloaded into /limine/ by
# tools/limine.py when no local loader is present)
/limine*/

# ─── Build / link / run logs ───────────────────────────────────────────────
/build_out.txt
/link_out.txt
/build_log.txt
# Any stray captured stdout/stderr logs
*_out.txt
*.log

# ─── QEMU runtime / debug artifacts ────────────────────────────────────────
/.qemu_pid
/qemu_debug.log
/serial.log
/runlog.txt
/run_output.txt

# ─── Editor / IDE / tooling ────────────────────────────────────────────────
# VS Code
/.vscode/

# Kiro
/.kiro/

# JetBrains
/.idea/

# VS Code Counter (extension output)
/.VSCodeCounter/

# ─── Downloaded / local-only bootloader blobs ──────────────────────────────
# Alternate local Limine binary directory (download locally)
/limine_bin/

# Vim / Emacs swap & backup files
*.swp
*.swo
*~

# macOS / Windows directory metadata
.DS_Store
Thumbs.db

# --- Stray test / debug / serial dumps ---
host_tests_ckpt9.txt
lx_serial.txt
*_ckpt*.txt
lx_serial*.txt
serial_*.txt
*.serial

# --- Python bytecode cache (tools/) ---
__pycache__/
*.pyc
pagh_mcp.py
# Linux QEMU writable OVMF variables
/.cache/

# Host-built Rust userspace examples
/rust-apps/**/target/
/rust-apps/out/
